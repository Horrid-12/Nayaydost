# ---------------------------------------------------------------------------
# NyayaDost configuration
# Copy this file to .env and edit the values you need.
# The app runs fully in offline demo mode when SARVAM_API_KEY is empty.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Kolkata

# Set this only on a trusted reverse proxy. It makes the app read the first
# address in X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# Sarvam AI (Mayura translation, Bulbul text-to-speech, Saaras speech-to-text)
# Leave empty to use the deterministic offline phrasebook, demo tone, and demo
# transcript. Never commit a real key.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_SPEAKER=shubh
SARVAM_TRANSLATE_TIMEOUT=15
SARVAM_TTS_TIMEOUT=25
SARVAM_STT_TIMEOUT=35
SARVAM_MAX_RETRIES=1

# Upload and content limits
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=60
MAX_TEXT_CHARS=50000
MAX_TTS_CHARS=900
MAX_TRANSLATE_CHARS=5000
MAX_STT_MB=10

# In-process rate limits (per client, per window)
RATE_LIMIT_ANALYZE=30
RATE_LIMIT_VOICE=25
RATE_LIMIT_WINDOW_SECONDS=60
